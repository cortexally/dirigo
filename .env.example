# Копия .env.example → .env и заполни. НЕ коммить .env (уже в .gitignore).
DIRIGO_TOKEN=смени-на-длинный-секрет
DIRIGO_PORT=7171
DIRIGO_MAX_WORKTREES=8
DIRIGO_WORKTREE_TTL_HOURS=24
DIRIGO_RL_API_MAX=0
DIRIGO_RL_API_WIN_MS=60000
# путь к проектам на хосте (монтируется в /projects внутри контейнера)
DIRIGO_PROJECTS_PATH=./projects
